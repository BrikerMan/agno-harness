# agno-relay configuration example

# General
API_ENV=local
DEBUG=true

# Teams Credentials (if using teams channel)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=
TEAMS_BOT_ENDPOINT=

# Lark / Feishu Credentials (if using lark channel)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# Ingestion Database
DATABASE_URL=sqlite+aiosqlite:///data/messages.db

# OpenTelemetry / Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
