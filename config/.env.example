# agno-harness configuration
# Each setting has exactly one key. No vendor aliases.

# LLM (OpenAI-compatible)
AGNO_HARNESS_LLM_BASE_URL=
AGNO_HARNESS_LLM_API_KEY=
AGNO_HARNESS_LLM_MODEL=gpt-4o

# Timezone for <context><time> (IANA). Unset = process local zone.
AGNO_HARNESS_TIMEZONE=

# Teams
AGNO_HARNESS_TEAMS_APP_ID=
AGNO_HARNESS_TEAMS_APP_PASSWORD=
AGNO_HARNESS_TEAMS_TENANT_ID=

# Lark / Feishu
AGNO_HARNESS_LARK_APP_ID=
AGNO_HARNESS_LARK_APP_SECRET=
AGNO_HARNESS_LARK_VERIFICATION_TOKEN=
AGNO_HARNESS_LARK_ENCRYPT_KEY=
AGNO_HARNESS_LARK_USE_WEBSOCKET=true

# Persistence
AGNO_HARNESS_DATABASE_URL=sqlite+aiosqlite:///data/messages.db
AGNO_HARNESS_REDIS_URL=

# Logging / debug traces
AGNO_HARNESS_LOG_LEVEL=INFO
AGNO_HARNESS_TRACE_DIR=

# OpenTelemetry / Langfuse (optional; standard OTEL keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
OTEL_SERVICE_NAME=agno-harness
OTEL_ENVIRONMENT=dev
